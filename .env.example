PORT=3008

# IntaSend
INTASEND_PUBLIC_KEY=
INTASEND_SECRET_KEY=
INTASEND_LIVE=false

# STK callback + base URL used to build B2C timeout/result URLs.
# CALLBACK_URL must point at the actually-mounted webhook route:
# <BACKEND_BASE_URL>/api/webhooks/mpesa/stk
CALLBACK_URL=
BACKEND_BASE_URL=

# Shared secret for POST /api/internal/compliance-sweep. The external
# scheduler (Render Cron Job or similar) must send it as:
#   Authorization: Bearer <this value>
INTERNAL_SWEEP_SECRET=

# JWT — REQUIRED. Must be the EXACT SAME value as the main backend's
# JWT_SECRET (backend/.env). The frontend authenticates against the main
# backend, which issues its own signed token (not a Firebase ID token) —
# see utils/backendJwt.js and middleware/auth.js for why this service
# needs to verify that same token. Without this set to match, every
# requireAuth-protected route here rejects every real logged-in user.
#
# Never leave this blank or set to a placeholder string — the main
# backend's jwt.js falls back to the literal "replace_with_a_long_random_secret"
# when unset, which is visible in source and lets anyone forge a valid
# token for any user. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# M-Pesa Daraja STK (required — STK push throws without these)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=

# M-Pesa Daraja B2C (required for seller/employee withdrawal payouts)
MPESA_B2C_SHORTCODE=
MPESA_B2C_INITIATOR_NAME=
MPESA_B2C_SECURITY_CREDENTIAL=

# Order delivery-completion code encryption (required — completion codes
# can't be generated/decrypted without this)
ORDER_CODE_ENCRYPTION_KEY=

# Finance withdrawals (employees/investors) result URL — optional, falls
# back to the marketplace B2C result URL if unset (which would misroute
# finance callbacks)
FINANCE_B2C_RESULT_URL=
